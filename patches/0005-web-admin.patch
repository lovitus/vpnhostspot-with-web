index 0000000000000000000000000000000000000000..1270b4e196f44dbd69ff9447af2ce4de61b69823
--- /dev/null
+++ b/mobile/src/main/java/be/mygod/vpnhotspot/DashboardCore.kt
@@ -0,0 +1,151 @@
+package be.mygod.vpnhotspot
+
+import java.io.ByteArrayOutputStream
+import java.net.ServerSocket
+import java.net.Socket
+import java.util.concurrent.ScheduledThreadPoolExecutor
+import java.util.concurrent.TimeUnit
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+
+/** Resources belong to one generation. Publication and shutdown share this object's monitor. */
+internal class DashboardSession {
+    @Volatile var active = true
+        private set
+    private var listener: ServerSocket? = null
+    private val sockets = HashSet<Socket>()
+
+    @Synchronized fun publish(candidate: ServerSocket): Boolean {
+        if (!active) { candidate.close(); return false }
+        listener = candidate
+        return true
+    }
+    @Synchronized fun attach(socket: Socket): Boolean {
+        // At most 16 accepted requests per downstream; rejected sockets never acquire a worker.
+        if (!active || sockets.size >= 16) { socket.close(); return false }
+        sockets.add(socket)
+        return true
+    }
+    @Synchronized fun detach(socket: Socket) { sockets.remove(socket) }
+    @Synchronized fun stop() {
+        active = false
+        listener?.close()
+        listener = null
+        sockets.forEach { it.close() }
+        sockets.clear()
+    }
+}
+
+/** SO_TIMEOUT only bounds reads. Closing the socket also interrupts a blocked response write. */
+internal object DashboardDeadline {
+    private val timer = ScheduledThreadPoolExecutor(1) { runnable ->
+        Thread(runnable, "dashboard-deadlines").apply { isDaemon = true }
+    }.apply { removeOnCancelPolicy = true }
+    fun arm(socket: Socket, milliseconds: Long) = timer.schedule({ socket.close() }, milliseconds, TimeUnit.MILLISECONDS)
+}
+
+internal object DashboardHttp {
+    private const val MAX_LINE = 4096
+    private const val MAX_HEADERS = 64
+    data class Request(val method: String, val path: String)
+
+    fun read(socket: Socket, deadlineNanos: Long): Request? {
+        val input = socket.getInputStream()
+        fun line(): String? {
+            val bytes = ByteArrayOutputStream()
+            while (true) {
+                val remaining = deadlineNanos - System.nanoTime()
+                if (remaining <= 0) return null
+                socket.soTimeout = (remaining / 1_000_000).coerceIn(1, Int.MAX_VALUE.toLong()).toInt()
+                val value = input.read()
+                if (value < 0) return null // EOF cannot complete a request/header line
+                if (value == 10) {
+                    val text = bytes.toString(Charsets.US_ASCII.name())
+                    return if (text.endsWith('\r')) text.dropLast(1) else null
+                }
+                if (bytes.size() >= MAX_LINE || value > 127 || value == 0) return null
+                bytes.write(value)
+            }
+        }
+        val parts = (line() ?: return null).split(' ')
+        if (parts.size != 3 || parts[2] != "HTTP/1.1" || !parts[1].startsWith('/') ||
+            parts[1].startsWith("//")) return null
+        var host: String? = null
+        var count = 0
+        while (true) {
+            val header = line() ?: return null
+            if (header.isEmpty()) break
+            if (++count > MAX_HEADERS || header[0].isWhitespace() || ':' !in header) return null
+            val name = header.substringBefore(':')
+            if (name.equals("Host", true)) {
+                if (host != null) return null
+                host = header.substringAfter(':').trim()
+            }
+            // No request bodies or pipelining; close after the single response.
+            if (name.equals("Transfer-Encoding", true) ||
+                name.equals("Content-Length", true) && header.substringAfter(':').trim() != "0") return null
+        }
+        val allowed = setOf(socket.localAddress.hostAddress, "vpnhotspot.lan")
+        if (host !in allowed && host?.removeSuffix(":80") !in allowed) return null
+        return Request(parts[0], parts[1].substringBefore('?'))
+    }
+}
+
+/** Cache the rendered immutable result, so readers never mutate the sampler's baseline. */
+internal class DashboardCache<T>(private val clock: () -> Long = { System.nanoTime() / 1_000_000 }) {
+    private val mutex = Mutex()
+    private var at: Long? = null
+    private var value: T? = null
+    suspend fun read(load: suspend () -> T): T = mutex.withLock {
+        val now = clock()
+        if (at == null || now - at!! >= 1000) {
+            value = load()
+            at = clock()
+        }
+        @Suppress("UNCHECKED_CAST")
+        value as T
+    }
+}
+
+/** Accumulate deltas by recorder source, preserving completed sources for this dashboard session. */
+internal class DashboardTraffic {
+    data class Counter(val source: String, val mac: String, val sent: Long, val received: Long)
+    data class Totals(val sent: Long, val received: Long)
+    data class Sample(val totals: Map<String, Totals>, val rates: Map<String, Totals>, val available: Boolean)
+    private val previous = HashMap<String, Counter>()
+    private val retired = HashSet<String>()
+    private val totals = HashMap<String, Totals>()
+    private var sampledAt: Long? = null
+    fun sample(counters: List<Counter>, now: Long, available: Boolean): Sample {
+        if (!available) return Sample(totals.toMap(), emptyMap(), false)
+        val currentSources = counters.mapTo(HashSet()) { it.source }
+        retired.addAll(previous.keys - currentSources)
+        previous.keys.retainAll(currentSources)
+        val delta = HashMap<String, Totals>()
+        val unavailable = HashSet<String>()
+        counters.forEach { current ->
+            val old = previous.put(current.source, current)
+            val wasRetired = retired.remove(current.source)
+            val reset = old != null && (current.sent < old.sent || current.received < old.received)
+            val sent = if (old == null || wasRetired || reset) 0 else current.sent - old.sent
+            val received = if (old == null || wasRetired || reset) 0 else current.received - old.received
+            if (wasRetired || reset) unavailable.add(current.mac)
+            val before = totals[current.mac] ?: Totals(0, 0)
+            totals[current.mac] = Totals(before.sent + sent, before.received + received)
+            val change = delta[current.mac] ?: Totals(0, 0)
+            delta[current.mac] = Totals(change.sent + sent, change.received + received)
+        }
+        val elapsed = sampledAt?.let { now - it }
+        sampledAt = now
+        return Sample(totals.toMap(), if (elapsed == null || elapsed <= 0) emptyMap() else
+            totals.mapValues { (mac, _) ->
+                val change = delta[mac] ?: Totals(0, 0)
+                Totals(change.sent * 1000 / elapsed, change.received * 1000 / elapsed)
+            }.filterKeys { it !in unavailable }, true)
+    }
+}
+
+/** Neighbour entries are addresses, not separate clients or Wi-Fi associations. */
+internal fun dashboardClients(addresses: List<Pair<String?, String>>): Map<String, List<String>> =
+    addresses.mapNotNull { (mac, ip) -> mac?.let { it to ip } }
+        .groupBy({ it.first }, { it.second }).toSortedMap().mapValues { (_, ips) -> ips.distinct().sorted() }
