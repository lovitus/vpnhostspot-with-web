index 0000000000000000000000000000000000000000..903e523a4ff39fe3d20647ca45a4ad8587c253f7
--- /dev/null
+++ b/mobile/src/main/java/be/mygod/vpnhotspot/WebAdmin.kt
@@ -0,0 +1,214 @@
+package be.mygod.vpnhotspot
+
+import be.mygod.vpnhotspot.net.NetlinkNeighbour
+import be.mygod.vpnhotspot.net.monitor.TrafficRecorder
+import be.mygod.vpnhotspot.net.monitor.Upstream
+import be.mygod.vpnhotspot.net.monitor.Upstreams
+import be.mygod.vpnhotspot.room.TrafficRecord
+import be.mygod.vpnhotspot.widget.SmartSnackbar
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.CoroutineStart
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.collect
+import kotlinx.coroutines.launch
+import timber.log.Timber
+import java.io.IOException
+import java.net.Inet4Address
+import java.net.NetworkInterface
+import java.net.ServerSocket
+import java.net.Socket
+import java.net.SocketException
+import java.net.SocketTimeoutException
+
+/** Read-only HTTP in the unprivileged app process; no routing or root authority. */
+object WebAdmin {
+    private const val PORT = 80
+    private const val REQUEST_DEADLINE_MS = 3000L
+    private val scope = CoroutineScope(Dispatchers.IO + SupervisorJob())
+    private val lifecycleLock = Any()
+    private val sessions = HashMap<String, Session>()
+    private data class RecorderSnapshot(val records: List<TrafficRecord>, val at: Long, val wallTime: Long)
+    private val recorderCache = DashboardCache<RecorderSnapshot>()
+    private class Session {
+        val createdAt = System.nanoTime() / 1_000_000
+        val resources = DashboardSession()
+        val cache = DashboardCache<String>()
+        val traffic = DashboardTraffic()
+        lateinit var job: Job
+        @Volatile var gateway = ""
+        @Volatile var vpn: Upstream? = null
+        @Volatile var neighbours: List<NetlinkNeighbour>? = null
+        @Volatile var neighboursAt = 0L
+    }
+
+    fun start(iface: String) = synchronized(lifecycleLock) {
+        if (sessions[iface]?.job?.isActive == true) return@synchronized
+        sessions.remove(iface)?.resources?.stop()
+        val session = Session()
+        session.job = scope.launch(start = CoroutineStart.LAZY) { serve(iface, session) }
+        sessions[iface] = session
+        session.job.start()
+    }
+
+    fun stop(iface: String) = synchronized(lifecycleLock) {
+        sessions.remove(iface)?.let { session ->
+            session.resources.stop()
+            session.job.cancel()
+        }
+    }
+
+    private suspend fun serve(iface: String, session: Session) {
+        val connectionScope = CoroutineScope(currentCoroutineContext())
+        val vpnJob = connectionScope.launch {
+            Upstreams.vpn.collect { session.vpn = it }
+        }
+        val neighbourJob = connectionScope.launch {
+            NetlinkNeighbour.snapshots.collect { snapshot ->
+                session.neighbours = snapshot.filter { it.dev == iface }
+                session.neighboursAt = System.nanoTime() / 1_000_000
+            }
+        }
+        try {
+            while (session.resources.active) {
+                val address = gatewayAddress(iface) ?: run { delay(500); continue }
+                try {
+                    ServerSocket(PORT, 16, address).use { candidate ->
+                        if (!session.resources.publish(candidate)) return@use
+                        session.gateway = address.hostAddress.orEmpty()
+                        candidate.soTimeout = 1000 // recheck the interface address during idle periods
+                        while (session.resources.active && gatewayAddress(iface) == address) {
+                            val socket = try { candidate.accept() } catch (_: SocketTimeoutException) { continue }
+                            if (!session.resources.attach(socket)) continue
+                            // Start the absolute deadline before queueing the worker; includes response writes.
+                            val deadline = DashboardDeadline.arm(socket, REQUEST_DEADLINE_MS)
+                            connectionScope.launch {
+                                try {
+                                    handle(socket, iface, session)
+                                } catch (_: IOException) {
+                                    // A client disconnect/absolute deadline affects only this exchange.
+                                } finally {
+                                    deadline.cancel(false)
+                                    socket.close()
+                                    session.resources.detach(socket)
+                                }
+                            }
+                        }
+                    }
+                } catch (e: IOException) {
+                    if (session.resources.active) {
+                        Timber.e(e, "Dashboard unavailable on %s:80", address.hostAddress)
+                        SmartSnackbar.make("Dashboard unavailable on ${address.hostAddress}:80: ${e.message}").show()
+                    }
+                    return
+                } catch (e: SecurityException) {
+                    Timber.e(e, "Dashboard bind denied on %s:80", address.hostAddress)
+                    SmartSnackbar.make("Dashboard bind denied on ${address.hostAddress}:80").show()
+                    return
+                }
+            }
+        } finally {
+            session.resources.stop()
+            vpnJob.cancel()
+            neighbourJob.cancel()
+            synchronized(lifecycleLock) {
+                // Identity matters: a late finally never touches a replacement generation.
+                if (sessions[iface] === session) sessions.remove(iface)
+            }
+        }
+    }
+
+    private suspend fun handle(socket: Socket, iface: String, session: Session) {
+        val request = DashboardHttp.read(socket, System.nanoTime() + REQUEST_DEADLINE_MS * 1_000_000) ?: return
+        if (request.method != "GET") {
+            reply(socket, 405, "text/plain; charset=utf-8", "method not allowed")
+            return
+        }
+        when (request.path) {
+            "/", "/index.html" -> reply(socket, 200, "text/html; charset=utf-8", INDEX)
+            "/api/status" -> reply(socket, 200, "application/json; charset=utf-8", status(iface, session))
+            else -> reply(socket, 404, "text/plain; charset=utf-8", "not found")
+        }
+    }
+
+    private fun gatewayAddress(iface: String): Inet4Address? = try {
+        NetworkInterface.getByName(iface)?.inetAddresses?.asSequence()
+            ?.filterIsInstance<Inet4Address>()?.singleOrNull()
+    } catch (_: SocketException) { null }
+
+    private fun reply(socket: Socket, code: Int, type: String, body: String) {
+        val bytes = body.toByteArray(Charsets.UTF_8)
+        val reason = when (code) { 200 -> "OK"; 404 -> "Not Found"; else -> "Method Not Allowed" }
+        val output = socket.getOutputStream()
+        output.write(("HTTP/1.1 $code $reason\r\nContent-Type: $type\r\nCache-Control: no-store\r\n" +
+            "Content-Security-Policy: default-src 'none'; connect-src 'self'; " +
+            "script-src 'unsafe-inline'; style-src 'unsafe-inline'\r\nX-Content-Type-Options: nosniff\r\n" +
+            "Connection: close\r\nContent-Length: ${bytes.size}\r\n\r\n").toByteArray(Charsets.US_ASCII))
+        output.write(bytes)
+        output.flush()
+    }
+
+    private suspend fun status(iface: String, session: Session): String = session.cache.read {
+        val snapshot = recorderCache.read {
+            RecorderSnapshot(TrafficRecorder.dashboardSnapshot(), System.nanoTime() / 1_000_000,
+                System.currentTimeMillis())
+        }
+        // A rapid routing restart must not seed the new session with a cached old-generation sample.
+        val records = snapshot.records.takeIf { snapshot.at >= session.createdAt }
+        val sample = session.traffic.sample(records.orEmpty().filter { it.downstream == iface }.map { record ->
+            DashboardTraffic.Counter(
+                "${record.mac}/${record.ip.hostAddress}/${record.upstream}", record.mac.toString(),
+                record.sentBytes, record.receivedBytes,
+            )
+        }, snapshot.at, records != null)
+        val observed = session.neighbours.takeIf {
+            val at = session.neighboursAt
+            at != 0L && System.nanoTime() / 1_000_000 - at <= 3000
+        }
+        val clients = dashboardClients(observed.orEmpty().map {
+            it.validClientMac?.toString() to it.ip.hostAddress.orEmpty()
+        }).map { (mac, ips) ->
+                val total = sample.totals[mac]
+                val rate = sample.rates[mac]
+                "{\"mac\":${json(mac)},\"ips\":[" +
+                    ips.joinToString(",", transform = ::json) +
+                    "],\"sendBytesPerSecond\":${rate?.sent},\"receiveBytesPerSecond\":${rate?.received}," +
+                    "\"sendBytes\":${total?.sent},\"receiveBytes\":${total?.received}}"
+            }
+        "{\"schema\":2,\"downstream\":${json(iface)},\"gateway\":${json(session.gateway)}," +
+            "\"sampledAt\":${snapshot.wallTime},\"trafficAvailable\":${sample.available}," +
+            "\"neighboursAvailable\":${observed != null},\"observedClientCount\":${clients.size}," +
+            "\"clients\":[${clients.joinToString()}],\"vpn\":${upstreamJson(session.vpn)}," +
+            "\"primary\":${upstreamJson(Upstreams.primary.value)}," +
+            "\"fallback\":${upstreamJson(Upstreams.fallback.value)}}"
+    }
+
+    private fun upstreamJson(value: Upstream?) = value?.let {
+        "{\"network\":${it.network.networkHandle},\"addresses\":[" +
+            it.properties.linkAddresses.joinToString(",") { address -> json(address.address.hostAddress.orEmpty()) } + "]}"
+    } ?: "null"
+
+    private fun json(value: String) = buildString {
+        append('"')
+        value.forEach { char ->
+            when (char) {
+                '\\' -> append("\\\\")
+                '"' -> append("\\\"")
+                else -> if (char < ' ') append("\\u%04x".format(char.code)) else append(char)
+            }
+        }
+        append('"')
+    }
+
+    private val INDEX = """
+        <!doctype html><meta name=viewport content="width=device-width,initial-scale=1"><title>VPNHotspot</title>
+        <style>body{font:16px system-ui;margin:24px;max-width:960px}table{border-collapse:collapse;width:100%}td,th{padding:8px;border-bottom:1px solid #ddd;text-align:left}.muted{color:#777}</style>
+        <h1>VPNHotspot</h1><p id=summary class=muted>loading...</p>
+        <p class=muted>Observed neighbours are not a Wi-Fi association count. Primary/fallback availability does not prove per-client routing. Totals include recorded sources for this dashboard session; unavailable values show —.</p>
+        <table><thead><tr><th>Observed client</th><th>IP addresses</th><th>↓ B/s</th><th>↑ B/s</th><th>Recorded session bytes</th></tr></thead><tbody id=clients></tbody></table>
+        <script>const fmt=v=>v===null?'—':v;async function refresh(){try{const s=await fetch('/api/status',{cache:'no-store'}).then(r=>r.json());summary.textContent=s.gateway+' · '+s.observedClientCount+' observed clients · VPN '+(s.vpn?'connected':'unavailable')+' · primary '+(s.primary?'available':'unavailable')+' · fallback '+(s.fallback?'available':'unavailable')+(s.trafficAvailable?'':' · traffic unavailable (prior totals retained)')+(s.neighboursAvailable?'':' · neighbours unavailable');clients.textContent='';s.clients.forEach(c=>{const tr=document.createElement('tr');[c.mac,c.ips.join(', '),fmt(c.receiveBytesPerSecond),fmt(c.sendBytesPerSecond),c.receiveBytes===null||c.sendBytes===null?'—':c.receiveBytes+c.sendBytes].forEach(v=>{const td=document.createElement('td');td.textContent=v;tr.append(td)});clients.append(tr)})}catch(e){summary.textContent='status unavailable'}}refresh();setInterval(refresh,1000)</script>
+    """.trimIndent()
+}
