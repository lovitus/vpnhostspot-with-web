 }
 
 async fn resolve_or_error(config: &SessionConfig, query: &[u8]) -> Option<DnsResponse> {
+    if dns_wire::is_dashboard_query(query) {
+        // Reuse downstream address selection: the default P2P address is not universal.
+        let gateway = timeout(DNS_QUERY_TIMEOUT, async {
+            let mut handle = crate::netlink::RequestConnection::new()?;
