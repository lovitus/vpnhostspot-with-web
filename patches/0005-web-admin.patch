+import be.mygod.vpnhotspot.widget.SmartSnackbar
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.CoroutineStart
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.collect
+import kotlinx.coroutines.launch
+import timber.log.Timber
+import java.io.IOException
+import java.net.Inet4Address
+import java.net.NetworkInterface
+import java.net.ServerSocket
+import java.net.Socket
+import java.net.SocketException
+import java.net.SocketTimeoutException
+
+/** Read-only HTTP in the unprivileged app process; no routing or root authority. */
+object WebAdmin {
+    private const val PORT = 8080
+    private const val REQUEST_DEADLINE_MS = 3000L
+    private val scope = CoroutineScope(Dispatchers.IO + SupervisorJob())
+    private val lifecycleLock = Any()
+    private val sessions = HashMap<String, Session>()
+    // Adapt identities from the existing P2P owner; never retain group credentials.
+    private val p2p = MutableStateFlow<Pair<String, Map<String, String>>?>(null)
+    fun observeP2pGroup(group: WifiP2pGroup?) {
+        p2p.value = group?.let { value -> value.`interface` to value.clientList.associate {
+            MacAddress.fromString(it.deviceAddress).toString() to it.deviceName.orEmpty()
+        } }
+    }
+    // Passive observation only. The recorder consumes retired DNS/NAT66 counters and persists
+    // them before publication, on its original schedule. No Web job owns a daemon request.
+    private val observationJob = scope.launch(start = CoroutineStart.LAZY) {
+        TrafficRecorder.counterSnapshots.collect { snapshot ->
+            val targets = synchronized(lifecycleLock) { sessions.toList() }
+            targets.forEach { (iface, session) ->
+                if (!session.resources.active) return@forEach
+                // A cached publication from an earlier generation must not seed a new session.
+                if (!snapshot.available || !snapshot.isNewerThan(session.createdAt)) {
+                    session.trafficSnapshots.invalidate()
+                    if (snapshot.wallTime != 0L && !snapshot.available)
+                        session.error("traffic", "recorder observation unavailable; retaining last publication")
+                    return@forEach
+                }
+                val counters = snapshot.counters.filter { it.downstream == iface }.mapNotNull { counter ->
+                    val key = TrafficRecorder.counterKey(counter) ?: return@mapNotNull null
+                    DashboardTraffic.Counter(
+                        "${key.mac}/${key.source.ip.hostAddress}/${key.source.upstream}", key.mac.toString(),
+                        counter.sent_bytes, counter.received_bytes,
+                    )
+                }
+                val dns = snapshot.counters.filter { it.downstream == iface }.mapNotNull { counter ->
+                    val key = TrafficRecorder.counterKey(counter) ?: return@mapNotNull null
+                    if (key.source.upstream != TrafficRecord.DAEMON_SOURCE_DNS) return@mapNotNull null
+                    key.mac.toString() to DashboardTraffic.Totals(counter.sent_packets, counter.received_packets)
+                }.toMap()
+                session.trafficSnapshots.update(DashboardTrafficSnapshot(
+                    session.traffic.sample(counters, snapshot.at, counters.isNotEmpty()),
+                    snapshot.at, snapshot.wallTime, dns,
+                ), snapshot.wallTime)
+            }
+        }
+    }
+    private class Session {
+        val createdAt = System.nanoTime() / 1_000_000
+        val resources = DashboardSession()
+        val trafficSnapshots = DashboardObservation<DashboardTrafficSnapshot>()
+        val traffic = DashboardTraffic()
+        val neighbours = DashboardObservation<NetlinkNeighbour.Snapshot>()
+        lateinit var job: Job
+        @Volatile var gateway = ""
+        @Volatile var type = TetherType.NONE
+        @Volatile var vpn: Map<String, Any?>? = null
+        @Volatile var primary: Map<String, Any?>? = null
+        @Volatile var fallback: Map<String, Any?>? = null
+        @Volatile var names: Map<String, String> = emptyMap()
+        @Volatile var errors: List<Map<String, Any?>> = emptyList()
+        @Synchronized fun error(source: String, message: String) {
+            // Bound diagnostics; repeated sampling timeouts need only one recent record.
+            if (errors.lastOrNull()?.get("source") == source && errors.lastOrNull()?.get("message") == message) return
+            errors = (errors + mapOf("at" to System.currentTimeMillis(), "source" to source,
+                "message" to message.take(1024))).takeLast(12)
+        }
+    }
+
+    fun start(iface: String) = synchronized(lifecycleLock) {
+        if (sessions[iface]?.job?.isActive == true) return@synchronized
+        sessions.remove(iface)?.resources?.stop()
+        val session = Session()
+        session.job = scope.launch(start = CoroutineStart.LAZY) { serve(iface, session) }
+        sessions[iface] = session
+        session.job.start()
+        observationJob.start()
+    }
+
+    fun stop(iface: String) = synchronized(lifecycleLock) {
+        sessions.remove(iface)?.let { session ->
+            session.resources.stop()
+            session.job.cancel()
+        }
+    }
+
+    private suspend fun serve(iface: String, session: Session) {
+        val connectionScope = CoroutineScope(currentCoroutineContext())
+        session.type = TetherType.ofInterface(iface)
+        val vpnJob = connectionScope.launch {
+            Upstreams.vpn.collect { session.vpn = upstreamJson(it) }
+        }
+        val primaryJob = connectionScope.launch { Upstreams.primary.collect { session.primary = upstreamJson(it) } }
+        val fallbackJob = connectionScope.launch { Upstreams.fallback.collect { session.fallback = upstreamJson(it) } }
+        val neighbourJob = connectionScope.launch {
+            NetlinkNeighbour.monitorObservations.collect { snapshot ->
+                if (snapshot.available) session.neighbours.update(snapshot, System.currentTimeMillis()) else {
+                    session.neighbours.invalidate()
+                    snapshot.unavailableReason?.let { session.error("neighbours", it) }
+                }
+            }
+        }
+        val namesJob = connectionScope.launch {
+            try {
+                // Same saved records as ClientViewModel; no Activity or database work in HTTP.
+                combine(NetlinkNeighbour.monitorObservations.map {
+                    if (it.available) it else session.neighbours.peek().value ?: it
+                }, p2p) { snapshot, association ->
+                    snapshot.neighbours.filter {
+                        (snapshot.bridgeMasterByMember[it.dev] ?: it.dev) == iface
+                    }.mapNotNull { it.lladdr }.toSet() +
+                        association?.takeIf { (snapshot.bridgeMasterByMember[it.first] ?: it.first) == iface }
+                            ?.second.orEmpty().keys.map(MacAddress::fromString)
+                }.collectLatest { macs ->
+                    if (macs.isEmpty()) session.names = emptyMap() else combine(macs.map { mac ->
+                        AppDatabase.instance.clientRecordDao.lookupOrDefaultFlow(mac)
+                    }) { records -> records.associate { it.mac.toString() to it.nickname.text } }
+                        .collect { session.names = it }
+                }
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: Exception) {
+                Timber.w(e, "Dashboard saved client names unavailable")
+                session.error("client_names", e.toString())
+            }
+        }
+        try {
+            while (session.resources.active) {
+                val address = gatewayAddress(iface) ?: run { delay(500); continue }
+                try {
+                    ServerSocket(PORT, 16, address).use { candidate ->
+                        if (!session.resources.publish(candidate)) return@use
+                        session.gateway = address.hostAddress.orEmpty()
+                        candidate.soTimeout = 1000 // recheck the interface address during idle periods
+                        while (session.resources.active && gatewayAddress(iface) == address) {
+                            val socket = try { candidate.accept() } catch (_: SocketTimeoutException) { continue }
+                            if (!session.resources.attach(socket)) continue
+                            // Start the absolute deadline before queueing the worker; includes response writes.
+                            val deadline = DashboardDeadline.arm(socket, REQUEST_DEADLINE_MS)
+                            connectionScope.launch {
+                                try {
+                                    handle(socket, iface, session)
+                                } catch (_: IOException) {
+                                    // A client disconnect/absolute deadline affects only this exchange.
+                                } finally {
+                                    deadline.cancel(false)
+                                    socket.close()
+                                    session.resources.detach(socket)
+                                }
+                            }
+                        }
+                    }
+                } catch (e: IOException) {
+                    if (session.resources.active) {
+                        Timber.e(e, "Dashboard unavailable on %s:8080", address.hostAddress)
+                        SmartSnackbar.make("Dashboard unavailable on ${address.hostAddress}:8080: ${e.message}").show()
+                    }
+                    return
+                } catch (e: SecurityException) {
+                    Timber.e(e, "Dashboard bind denied on %s:8080", address.hostAddress)
+                    SmartSnackbar.make("Dashboard bind denied on ${address.hostAddress}:8080").show()
+                    return
+                }
+            }
+        } finally {
+            session.resources.stop()
+            vpnJob.cancel()
+            primaryJob.cancel()
+            fallbackJob.cancel()
+            neighbourJob.cancel()
+            namesJob.cancel()
+            synchronized(lifecycleLock) {
+                // Identity matters: a late finally never touches a replacement generation.
+                if (sessions[iface] === session) sessions.remove(iface)
+            }
+        }
+    }
+
+    private suspend fun handle(socket: Socket, iface: String, session: Session) {
+        val request = DashboardHttp.read(socket, System.nanoTime() + REQUEST_DEADLINE_MS * 1_000_000) ?: return
+        if (request.method != "GET") {
+            reply(socket, 405, "text/plain; charset=utf-8", "method not allowed")
+            return
+        }
+        when (request.path) {
+            "/", "/index.html" -> reply(socket, 200, "text/html; charset=utf-8", DASHBOARD_PAGE)
+            "/api/status", "/api/debug" -> reply(socket, 200, "application/json; charset=utf-8", status(iface, session))
+            else -> reply(socket, 404, "text/plain; charset=utf-8", "not found")
+        }
+    }
+
+    private fun gatewayAddress(iface: String): Inet4Address? = try {
+        NetworkInterface.getByName(iface)?.inetAddresses?.asSequence()
+            ?.filterIsInstance<Inet4Address>()?.singleOrNull()
+    } catch (_: SocketException) { null }
+
+    private fun reply(socket: Socket, code: Int, type: String, body: String) {
+        val bytes = body.toByteArray(Charsets.UTF_8)
+        val reason = when (code) { 200 -> "OK"; 404 -> "Not Found"; else -> "Method Not Allowed" }
+        val output = socket.getOutputStream()
+        output.write(("HTTP/1.1 $code $reason\r\nContent-Type: $type\r\nCache-Control: no-store\r\n" +
+            "Content-Security-Policy: default-src 'none'; connect-src 'self'; " +
+            "script-src 'unsafe-inline'; style-src 'unsafe-inline'\r\nX-Content-Type-Options: nosniff\r\n" +
+            "Connection: close\r\nContent-Length: ${bytes.size}\r\n\r\n").toByteArray(Charsets.US_ASCII))
+        output.write(bytes)
+        output.flush()
+    }
+
+    private fun status(iface: String, session: Session): String {
+        val now = System.nanoTime() / 1_000_000
+        val traffic = session.trafficSnapshots.peek()
+        val snapshot = traffic.value
+        val sample = snapshot?.current(now, traffic.available) ?: DashboardTraffic.Sample(emptyMap(), emptyMap(), false)
+        val observed = session.neighbours.peek() // event-driven; unchanged tables have no TTL
+        val association = p2p.value?.takeIf {
+            (observed.value?.bridgeMasterByMember?.get(it.first) ?: it.first) == iface
+        }?.second
+        val type = if (association != null) TetherType.WIFI_P2P else session.type
+        val grouped = LinkedHashMap<String, Client>()
+        association?.forEach { (mac, _) ->
+            grouped[mac] = Client(MacAddress.fromString(mac), iface, type).apply { active = true }
+        }
+        observed.value?.let { value -> value.neighbours.forEach { neighbour ->
+            if ((value.bridgeMasterByMember[neighbour.dev] ?: neighbour.dev) != iface) return@forEach
+            val mac = neighbour.lladdr ?: return@forEach
+            grouped.getOrPut(mac.toString()) { Client(mac, iface, type) }.apply {
+                addSource(neighbour.dev)
+                ip[neighbour.ip] = ClientAddressInfo(neighbour.state)
+                if (association == null && observed.available && neighbour.state == NeighbourState.NEIGHBOUR_STATE_VALID)
+                    active = true
+            }
+        } }
+        val clients = grouped.toSortedMap().map { (mac, client) ->
+            val total = sample.totals[mac]
+            val rate = sample.rates[mac]
+            val dns = snapshot?.dnsPackets?.get(mac)
+            val nickname = session.names[mac]?.takeIf { it.isNotBlank() }
+            mapOf(
+                "mac" to mac, "name" to (nickname ?: association?.get(mac)?.takeIf { it.isNotBlank() }),
+                "nameSource" to (if (nickname != null) "ClientRecord" else if (!association?.get(mac).isNullOrBlank())
+                    "RepeaterService.group" else null),
+                "interface" to iface, "interfaces" to client.ifaces.toList(), "type" to client.type.name,
+                "ips" to client.ip.keys.map { it.hostAddress },
+                "ipv4" to client.ip.keys.filterIsInstance<Inet4Address>().map { it.hostAddress },
+                "ipv6" to client.ip.keys.filter { it !is Inet4Address }.map { it.hostAddress },
+                "neighbourStates" to client.ip.map { (ip, info) -> mapOf("ip" to ip.hostAddress, "state" to info.state.value) },
+                "online" to association?.containsKey(mac),
+                "state" to when {
+                    association?.containsKey(mac) == true -> "associated"
+                    association != null -> "not_associated"
+                    !observed.available -> "unknown"
+                    client.active -> "neighbour_valid"
+                    else -> "neighbour_invalid"
+                },
+                "sendBytesPerSecond" to rate?.sent, "receiveBytesPerSecond" to rate?.received,
+                "sendBytes" to total?.sent, "receiveBytes" to total?.received,
+                "upstreamDnsSentPackets" to dns?.sent, "upstreamDnsReceivedPackets" to dns?.received,
+                "dnsCountersAvailable" to (sample.available && dns != null),
+                "dnsSuccessCount" to null, "dnsFailureCount" to null,
+                "activeTcpFlows" to null, "activeUdpFlows" to null, "currentEgress" to null,
+                "lastActivityAt" to null,
+                "lastTrafficChangeAgoMillis" to sample.lastChange[mac]?.let { (now - it).coerceAtLeast(0) },
+            )
+        }
+        return dashboardJson(mapOf(
+            "schema" to 3, "downstream" to iface, "gateway" to session.gateway, "port" to PORT,
+            "uptimeMillis" to (now - session.createdAt), "sampledAt" to snapshot?.wallTime?.takeIf { it != 0L },
+            "trafficAvailable" to sample.available, "neighboursAvailable" to observed.available,
+            "trafficRateWindowMillis" to sample.rateWindowMillis,
+            "neighboursChangedAt" to observed.changedAt, "observedClientCount" to grouped.size,
+            "neighbourClientCount" to grouped.values.count { it.ip.isNotEmpty() },
+            "validNeighbourClientCount" to grouped.values.count { client ->
+                client.ip.values.any { it.state == NeighbourState.NEIGHBOUR_STATE_VALID }
+            },
+            "associatedClientCount" to association?.size, "associationSource" to association?.let { "RepeaterService.group" },
+            "clients" to clients, "traffic" to dashboardTrafficSummary(sample),
+            "vpn" to session.vpn, "primary" to session.primary, "fallback" to session.fallback,
+            "selectedUpstream" to session.primary,
+            "selectedUpstreamMeaning" to "Upstreams.primary role selection; not observed per-flow egress",
+            "fallbackInUse" to null, "currentEgress" to null,
+            "diagnostics" to mapOf(
+                // Counter replies may omit failed sources; they cannot establish daemon-wide health.
+                "daemon" to null,
+                "counterObservation" to (if (sample.available) "recorder_reply_observed" else "unavailable"),
+                "counterSampledAt" to snapshot?.wallTime?.takeIf { it != 0L },
+                "counterAgeMillis" to snapshot?.let { (now - it.at).coerceAtLeast(0) },
+                "dnsStatus" to "resolver packet counters only; health and success/failure totals unavailable",
+                "routeStatus" to "Android upstream link routes; effective downstream/per-flow routing unavailable",
+                "recentErrors" to session.errors, "errorScope" to "recorder publication, monitor and name observations only",
+                "appVersion" to BuildConfig.VERSION_NAME, "versionCode" to BuildConfig.VERSION_CODE,
+                "patchRelease" to "0005-dashboard-schema3", "android" to Build.VERSION.RELEASE,
+                "androidApi" to Build.VERSION.SDK_INT, "kernel" to System.getProperty("os.version"),
+                "deviceUptimeMillis" to SystemClock.elapsedRealtime(),
+                "unavailable" to listOf("DNS success/failure totals", "TCP/UDP active flows", "per-client egress",
+                    "fallback use", "exact last packet activity", "Wi-Fi associations outside current P2P group"),
+            ),
+        ))
+    }
+
+    private fun upstreamJson(value: Upstream?): Map<String, Any?>? = value?.let {
+        // Existing Android connectivity state, observed off HTTP workers; no new routing selection.
+        val capabilities = try {
+            Services.connectivity.getNetworkCapabilities(it.network)
+        } catch (e: SecurityException) {
+            Timber.w(e, "Dashboard upstream capabilities unavailable")
+            null
+        }
+        mapOf(
+            "network" to it.network.networkHandle, "interface" to it.properties.interfaceName,
+            "interfaces" to it.properties.allInterfaceNames,
+            "type" to capabilities?.let { caps -> listOf(
+                NetworkCapabilities.TRANSPORT_VPN to "VPN", NetworkCapabilities.TRANSPORT_WIFI to "Wi-Fi",
+                NetworkCapabilities.TRANSPORT_CELLULAR to "cellular", NetworkCapabilities.TRANSPORT_ETHERNET to "Ethernet",
+                NetworkCapabilities.TRANSPORT_BLUETOOTH to "Bluetooth",
+            ).filter { (transport, _) -> caps.hasTransport(transport) }.map { (_, name) -> name } },
+            "validated" to capabilities?.hasCapability(NetworkCapabilities.NET_CAPABILITY_VALIDATED),
+            "capabilitiesObservedAt" to System.currentTimeMillis(),
+            "addresses" to it.properties.linkAddresses.map { address -> address.toString() },
+            "dnsServers" to it.properties.dnsServers.map { address -> address.hostAddress },
+            "routes" to it.properties.allRoutes.map { route -> mapOf(
+                "destination" to route.destination.toString(), "gateway" to route.gateway?.hostAddress,
+                "interface" to route.`interface`, "type" to route.type,
+            ) },
+        )
+    }
+
+
+}
