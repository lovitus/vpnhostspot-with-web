@@ -6,6 +6,57 @@ const FLAGS_OPCODE_MASK: u8 = 0x78;
 const FLAGS_AD_CD_MASK: u8 = 0x30;
 const RCODE_SERVFAIL: u8 = 2;
 
+pub fn local_admin_response(query: &[u8], address: [u8; 4]) -> Option<Vec<u8>> {
+    if query.len() < HEADER_LEN
+        || query[2] & FLAG_RESPONSE != 0
+        || u16::from_be_bytes([query[4], query[5]]) != 1
+    {
+        return None;
+    }
+    let name_start = HEADER_LEN;
+    let name_end = name_end(query, name_start)?;
+    let qtype = u16::from_be_bytes([*query.get(name_end)?, *query.get(name_end + 1)?]);
+    let qclass = u16::from_be_bytes([*query.get(name_end + 2)?, *query.get(name_end + 3)?]);
+    if qtype != 1 || qclass != 1 || !same_name(query, name_start, name_end, b"vpnhotspot.lan") {
+        return None;
+    }
+    let question_end = name_end + 4;
+    let mut response = Vec::with_capacity(question_end + 16);
+    response.extend_from_slice(&query[..2]);
+    response
+        .push(FLAG_RESPONSE | (query[2] & FLAGS_OPCODE_MASK) | (query[2] & FLAG_RECURSION_DESIRED));
+    response.push(FLAG_RECURSION_AVAILABLE | (query[3] & FLAGS_AD_CD_MASK));
+    response.extend_from_slice(&[0, 1, 0, 1, 0, 0, 0, 0]);
+    response.extend_from_slice(&query[HEADER_LEN..question_end]);
+    response.extend_from_slice(&[0xC0, 0x0C, 0, 1, 0, 1, 0, 0, 0, 0, 0, 4]);
+    response.extend_from_slice(&address);
+    Some(response)
+}
+
+fn same_name(packet: &[u8], start: usize, end: usize, expected: &[u8]) -> bool {
+    let mut offset = start;
+    let mut plain = Vec::new();
+    while offset < end {
+        let length = packet[offset] as usize;
+        if length == 0 {
+            return offset + 1 == end && plain == expected;
+        }
+        if offset + 1 + length > end {
+            return false;
+        }
+        if !plain.is_empty() {
+            plain.push(b'.');
+        }
+        plain.extend(
+            packet[offset + 1..offset + 1 + length]
+                .iter()
+                .map(|byte| byte.to_ascii_lowercase()),
+        );
+        offset += 1 + length;
+    }
+    plain == expected
+}
