+package be.mygod.vpnhotspot
+
+/** Adapt the existing session counters; a missing baseline must not turn into a displayed zero speed. */
+internal fun dashboardTrafficSummary(sample: DashboardTraffic.Sample): Map<String, Long?> {
+    val totals = sample.totals.values.takeIf { it.isNotEmpty() }
+    val rates = sample.rates.values.takeIf {
+        sample.available && totals != null && sample.rates.keys.containsAll(sample.totals.keys)
+    }
+    return mapOf(
+        "sendBytes" to totals?.sumOf { it.sent }, "receiveBytes" to totals?.sumOf { it.received },
+        "sendBytesPerSecond" to rates?.sumOf { it.sent }, "receiveBytesPerSecond" to rates?.sumOf { it.received },
+    )
+}
+
+/** Small JSON boundary over immutable maps/lists; Android's JSON implementation is not required by JVM tests. */
+internal fun dashboardJson(value: Any?): String = when (value) {
+    null -> "null"
+    is String -> buildString {
+        append('"')
+        value.forEach { char -> when (char) {
+            '\\' -> append("\\\\")
+            '"' -> append("\\\"")
+            else -> if (char < ' ') append("\\u%04x".format(char.code)) else append(char)
+        } }
+        append('"')
+    }
+    is Boolean, is Number -> value.toString()
+    is Map<*, *> -> value.entries.joinToString(",", "{", "}") {
+        dashboardJson(it.key as String) + ":" + dashboardJson(it.value)
+    }
+    is Iterable<*> -> value.joinToString(",", "[", "]", transform = ::dashboardJson)
+    else -> error("Unsupported dashboard JSON value: ${value.javaClass}")
+}
